NODE_ENV=production
DATABASE_URL=your-neon-postgres-connection-string
CLIENT_ORIGINS=https://your-frontend-domain.com

PRIMARY_DOMAIN=your-primary-domain.com
LOCAL_TENANT_QUERY_PARAM=hotel

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-admin-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="Ranjeet Groups <bookings@your-domain.com>"

PUBLIC_RECEIPT_BASE_URL=https://your-backend-domain.com/receipts
