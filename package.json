{
  "name": "rs-exclusive-platform",
  "private": true,
  "version": "1.0.0",
  "description": "Multi-tenant booking SaaS for R.S. Exclusive Stay & Fine Dine.",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:client dev:server",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "bootstrap:super-admin": "npm run bootstrap:super-admin --workspace server",
    "test": "npm run test --workspace server",
    "lint": "npm run lint --workspace client && npm run lint --workspace server"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "psql": "^0.0.1"
  }
}
